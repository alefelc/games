diff --git a/games-main/vite.config.ts b/games-main/vite.config.ts
--- a/games-main/vite.config.ts
+++ b/games-main/vite.config.ts
@@ -57,6 +57,8 @@ export default defineConfig(({ mode }) => {
           navigateFallbackDenylist: [
             /^\/api\/game-master\//,
             /^\/build-info\.json$/,
+            /^\/robots\.txt$/,
+            /^\/sitemap\.xml$/,
           ],
           globPatterns: ["**/*.{js,css,html,svg,png,json,webmanifest}"],
           maximumFileSizeToCacheInBytes: 12 * 1024 * 1024,
diff --git a/games-main/deploy/default.conf.template b/games-main/deploy/default.conf.template
--- a/games-main/deploy/default.conf.template
+++ b/games-main/deploy/default.conf.template
@@ -27,6 +27,24 @@ server {
     add_header Cache-Control "no-store" always;
   }
 
+  # Archivos públicos para buscadores. Las coincidencias exactas evitan que
+  # una ausencia o un error de copia termine devolviendo index.html.
+  location = /robots.txt {
+    default_type text/plain;
+    charset utf-8;
+    include /etc/nginx/security-headers.conf;
+    add_header Cache-Control "no-cache" always;
+    try_files $uri =404;
+  }
+
+  location = /sitemap.xml {
+    default_type application/xml;
+    charset utf-8;
+    include /etc/nginx/security-headers.conf;
+    add_header Cache-Control "no-cache" always;
+    try_files $uri =404;
+  }
+
   location / {
     try_files $uri $uri/ /index.html;
   }
